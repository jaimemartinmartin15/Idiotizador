{
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "idiotizador": {
      "projectType": "application",
      "root": "",
      "architect": {
        "deploy": {
          "builder": "@jaimemartinmartin15/jei-devkit-angular-builders:aws-deploy",
          "options": {
            "serverSegment": "idiotizador",
            "distFolder": "dist",
            "overriddenRequest": [],
            "noCache": ["index.html"]
          }
        }
      }
    }
  }
}